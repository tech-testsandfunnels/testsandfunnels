# Copy to backend/.env and adjust. backend/.env is gitignored.
PORT=5000

# Local MongoDB (start it with: mongod). Or paste an Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27017/testsandfunnels

# Dashboard login. In production (NODE_ENV=production) both are REQUIRED.
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# Origins allowed to call the public website endpoints (/api/intake, /api/slots).
# Comma list. Use * only for local testing.
CORS_ORIGINS=https://testsandfunnels.com,https://www.testsandfunnels.com

# Website bookings: false = "requested" until someone confirms in the dashboard,
# true = confirmed at once (the page then says "You are booked in").
INTAKE_AUTO_CONFIRM=false

# Max intake requests per minute per IP.
INTAKE_RATE_PER_MIN=10

# Public URL of this CRM (shown in the dashboard's Website forms view). Optional.
# PUBLIC_URL=https://crm.testsandfunnels.com

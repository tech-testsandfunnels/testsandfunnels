---
/* /contact/ : thin wrapper. Content is src/html/contact.html (raw <main>),
   structured data is src/html/contact.jsonld.html. Meta lives in the props below. */
import Layout from '../../layouts/Layout.astro';
import main from '../../html/contact.html?raw';
import jsonLd from '../../html/contact.jsonld.html?raw';
---
<Layout
  title="Contact tests&funnels: Call, WhatsApp, Email"
  description="Contact tests&funnels in Delhi by phone, WhatsApp, email or form for agency, training, incubation and partnership enquiries."
  pageType="contact"
  navCurrent="/about/"
  keywords="contact tests&funnels, marketing agency contact Delhi, WhatsApp, call, email, agency enquiry, training enquiry, incubation enquiry"
  jsonLd={jsonLd}
>
  <Fragment set:html={main} />
</Layout>

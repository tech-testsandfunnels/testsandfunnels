---
/* /404 : thin wrapper. Content is src/html/404.html (raw <main>),
   structured data is src/html/404.jsonld.html. Meta lives in the props below. */
import Layout from '../layouts/Layout.astro';
import main from '../html/404.html?raw';
import jsonLd from '../html/404.jsonld.html?raw';
---
<Layout
  title="Page not found | tests&funnels"
  description="This page could not be found."
  pageType="error"
  noindex
  jsonLd={jsonLd}
>
  <Fragment set:html={main} />
</Layout>

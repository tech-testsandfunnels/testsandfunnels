---
/**
 * Layout.astro
 *
 * What it is: the single HTML shell wrapped around every page.
 * Why it exists: the head (meta, Open Graph, Twitter, JSON-LD), the header,
 *   nav, footer, mobile bar, floating CTA, video modal, icon sprite, theme
 *   script and site script live ONCE here, so a change is made in one place.
 * Pages supply their <main> (src/html/<slug>.html) and their meta as props.
 *
 * Forms: every lead form is two steps (details, then pick a call time). The
 *   shared script posts tf-intake/1 events to the CRM (window.TF.intake) and
 *   reads free slots from window.TF.slots. Both come from the build variables
 *   PUBLIC_CRM_INTAKE_URL / PUBLIC_CRM_SLOTS_URL; the default is the live CRM.
 *   An empty PUBLIC_CRM_INTAKE_URL turns the CRM off (forms finish in WhatsApp).
 * Google Tag Manager: set GTM_ID below (empty = off). It runs on every page.
 */
import '../styles/global.css';
import pre from '../chrome/pre.html?raw'; // icon sprite + skip link + progress bar + header + mobile nav
import post from '../chrome/post.html?raw'; // footer + mobile action bar + floating CTA + video modal
import app from '../chrome/app.js?raw'; // shared interactions: nav, two-step forms, scroll reveal, counters, modal

interface Props {
  title: string;
  description: string;
  keywords?: string;
  pageType?: string; // <body data-page-type>, used by the script for analytics
  navCurrent?: string; // href of the top nav item to mark as current, e.g. "/services/"
  noindex?: boolean; // 404: no canonical, no OG image, robots noindex
  jsonLd?: string; // raw <script type="application/ld+json"> blocks for this page
  published?: string; // ISO date; article:published_time
  modified?: string; // ISO date; article:modified_time and og:updated_time
}

const SITE = 'https://testsandfunnels.com';
const OG_IMAGE = SITE + '/media/og-default.jpg';
const OG_ALT = 'tests&funnels: AI agency, production house and incubator in Delhi';
/* Google Tag Manager container. Empty string = no Tag Manager. */
const GTM_ID = 'GTM-NVPFL9XK';

const {
  title,
  description,
  keywords = '',
  pageType = '',
  navCurrent = '',
  noindex = false,
  jsonLd = '',
  published = '2026-11-14',
  modified = '2026-11-14',
} = Astro.props;

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const canon = SITE + (noindex ? '/' : path);
const mdHref = SITE + (path === '/' ? '/index.md' : path + 'index.md');

/* CRM endpoints for the forms. Default: the live CRM. Override at build time. */
const intake = import.meta.env.PUBLIC_CRM_INTAKE_URL ?? 'https://crm.testsandfunnels.com/api/intake';
const slots = intake ? (import.meta.env.PUBLIC_CRM_SLOTS_URL || intake.replace(/\/api\/intake\/?$/, '/api/slots')) : '';
const tfConfig =
  'window.TF=' +
  JSON.stringify({
    intake,
    slots,
    wa: '917507994138',
    phone: '+91 75079 94138',
    email: 'admin@testsandfunnels.com',
    auditHref: '/free-business-audit/',
    /* Fallback booking hours (India time) shown until the CRM answers /api/slots.
       Keep in step with Settings > Booking hours in the CRM. */
    hours: { days: [1, 2, 3, 4, 5, 6], start: '11:00', end: '18:00', step: 30, lead: 3, ahead: 14 },
  }) +
  ';';

/* Tag Manager snippet (head) and its noscript fallback (first thing in body). */
const gtmHead =
  "(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});" +
  "var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;" +
  "j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})" +
  "(window,document,'script','dataLayer','" + GTM_ID + "');";
const gtmBody =
  '<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=' + GTM_ID +
  '" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>';

/* Mark the current top-level nav item (the page tells us which one). */
const header = navCurrent
  ? pre.replace(`href="${navCurrent}" aria-haspopup="true"`, `href="${navCurrent}" aria-haspopup="true" aria-current="page"`)
  : pre;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'} />
    <meta name="theme-color" content="#383C4F" />
    {!noindex && <link rel="canonical" href={canon} />}

    {/* Open Graph / Twitter */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="tests&funnels" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canon} />
    <meta property="og:locale" content="en_IN" />
    {!noindex && (
      <>
        <meta name="author" content="tests&funnels" />
        <meta property="article:published_time" content={published} />
        <meta property="article:modified_time" content={modified} />
        <meta property="og:updated_time" content={modified} />
        <meta property="og:image" content={OG_IMAGE} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={OG_ALT} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={OG_IMAGE} />
        <meta name="twitter:image:alt" content={OG_ALT} />
        <link rel="alternate" type="text/markdown" href={mdHref} />
      </>
    )}
    {noindex && <meta name="twitter:card" content="summary" />}
    {path === '/' && <link rel="alternate" type="text/plain" href={SITE + '/llms.txt'} title="llms.txt" />}
    <meta name="color-scheme" content="light dark" />

    {/* Theme (light/dark) and the js flag, before first paint so nothing flashes */}
    <script is:inline>document.documentElement.classList.add("js");try{var t=localStorage.getItem("tf-theme");if(t!=="dark"&&t!=="light")t=window.matchMedia&&matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light";document.documentElement.setAttribute("data-theme",t)}catch(e){}</script>

    {/* Google Tag Manager (after the theme script, as in the site build) */}
    {GTM_ID && <script is:inline set:html={gtmHead}></script>}

    {/* Favicon (files in public/) */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Fonts. TODO: self-host via Fontsource to drop the third-party request. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    {/* Per-page structured data */}
    {jsonLd && <Fragment set:html={jsonLd} />}
  </head>

  <body data-page-type={pageType}>
    {GTM_ID && <Fragment set:html={gtmBody} />}

    {/* Shared chrome before the page content */}
    <Fragment set:html={header} />

    {/* The page supplies its own <main> here */}
    <slot />

    {/* Shared chrome after the page content */}
    <Fragment set:html={post} />

    {/* Site config + interactions, kept verbatim so behaviour is unchanged */}
    <script is:inline set:html={tfConfig}></script>
    <script is:inline set:html={app}></script>
  </body>
</html>
